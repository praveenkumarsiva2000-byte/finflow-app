PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/finflow

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=7d

CLIENT_URL=http://localhost:3000

# SMTP (Nodemailer) — used for password reset OTP + notification emails.
# Leave blank to run in dev mode: emails are logged to the console instead of sent.
# For Gmail: use an App Password (not your account password), SMTP_HOST=smtp.gmail.com, SMTP_PORT=587.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=FinFlow <no-reply@finflow.app>
